NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# PostgreSQL native - không dùng Docker.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/halo_hola

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES=7d

# Comma-separated frontend origins.
CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_FILE_SIZE_MB=25
MAX_UPLOAD_FILE_COUNT=10

# Optional fallback for development admin access.
ADMIN_API_KEY=halo-hola-admin-dev

ADMIN_SEED_NAME=HALO HOLA Admin
ADMIN_SEED_EMAIL=admin@halohola.vn
ADMIN_SEED_PASSWORD=change_me_before_use
