NODE_ENV=production
PORT=5000
PUBLIC_BASE_URL=https://halohola.xspace.vn
HALO_HOLA_SITE_URL=https://halohola.xspace.vn

DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/halo_hola
PG_POOL_MAX=20

JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES=7d

# Temporary production domain. Add the official domain later, separated by comma during migration.
CORS_ORIGIN=https://halohola.xspace.vn

# HALO HOLA -> Hola Maps server-to-server sync. Secret chỉ nằm ở backend.
HOLA_MAPS_BASE_URL=https://maps.dothihoalac.vn
HOLA_MAPS_HALO_SECRET=CHANGE_TO_THE_SAME_SECRET_CONFIGURED_IN_HOLA_MAPS
HOLA_MAPS_SYNC_TIMEOUT_MS=8000

# Required in production when accepting uploaded original submission files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_ORIGINALS=halo-hola-originals
R2_BUCKET_PUBLIC=halo-hola-public

UPLOAD_DIR=uploads
MAX_UPLOAD_FILE_SIZE_MB=100
MAX_UPLOAD_FILE_COUNT=10

# Development/local emergency key only. Production ignores x-admin-key authentication.
ADMIN_API_KEY=
ADMIN_SEED_NAME=HALO HOLA Admin
ADMIN_SEED_EMAIL=admin@halohola.vn
ADMIN_SEED_PASSWORD=CHANGE_ME

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=HALO HOLA
MAIL_FROM=
