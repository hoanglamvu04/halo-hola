{
  "name": "halo-hola",
  "private": true,
  "version": "1.0.0",
  "description": "HALO HOLA 2026 - storytelling, community and experience platform for Hoa Lac",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,yellow \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm ci --prefix backend && npm ci --prefix frontend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:seed:admin": "npm run db:seed:admin --prefix backend",
    "dev:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auto-dev.ps1",
    "auto:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-auto-start.ps1",
    "auto:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-auto-start.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
