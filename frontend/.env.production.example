# Production frontend
# Keep the HALO HOLA backend API relative so changing domain later does not require changing API host.
VITE_API_URL=/api
VITE_SITE_URL=https://halohola.xspace.vn

# Hola Maps Developer API v1. OPEN mode works without a key once this origin is allowed by Hola Maps.
VITE_HOLA_MAPS_API_URL=https://maps.dothihoalac.vn/api/public/v1
# Optional PARTNER Browser Client key. Do not put a secret server key in Vite/browser env.
VITE_HOLA_MAPS_API_KEY=
