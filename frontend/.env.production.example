# Production frontend
# Keep the HALO HOLA backend API relative so changing domain later does not require changing API host.
VITE_API_URL=/api
VITE_SITE_URL=https://halohola.vn

# Facebook group used by the post-submission sharing flow.
# This is a public browser URL, not an API token or secret.
VITE_CHECKIN_HOALAC_GROUP_URL=

# Hola Maps public browser endpoints. Shared sync secret MUST stay in backend env only.
VITE_HOLA_MAPS_ORIGIN=https://maps.dothihoalac.vn
VITE_HOLA_MAPS_API_URL=https://maps.dothihoalac.vn/api/public/v1
# Optional PARTNER Browser Client key. Do not put a secret server key in Vite/browser env.
VITE_HOLA_MAPS_API_KEY=

# HOLA Embed Platform V1 is configured live in Admin > Cài đặt > Tích hợp HOLA Maps.
# Its he_... iframe identifier is PUBLIC and is not the Browser API key above.
# No VITE_HOLA_MAPS_EMBED_URL is needed; Site Settings survives rebuilds/rotation.
# HOLA_MAPS_HALO_SECRET stays ONLY in backend environment variables.
